# Public configuration, embedded in the app bundle: anyone can read these values.
# Never put a secret here. Copy to .env.local and fill in for your machine.

# Lalana API base URL (http is accepted only for localhost, 10.0.2.2 or 192.168.x.x).
EXPO_PUBLIC_API_URL=http://10.0.2.2:5080

# Supabase project (Auth only). The anon key is public by design.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
