# Local Docker Compose settings. Copy to api/.env (ignored by git) and change the values.
# These are local development values only: real secrets live on the server, never in git.

# Password of the local PostgreSQL user "lalana".
POSTGRES_PASSWORD=change-me-local

# ES256 private key (PEM, ECDSA P-256) that signs and verifies access tokens. Leave empty in
# Development: the API then generates a throwaway key, so sessions end when it restarts.
# Required outside Development. Generate one with:
#   openssl ecparam -name prime256v1 -genkey -noout | openssl pkcs8 -topk8 -nocrypt
AUTH_SIGNING_KEY_PEM=

# Base64 key (32 bytes or more) of the HMAC that hashes one-time codes. Leave empty in
# Development (throwaway key). Required outside Development. Generate one with:
#   openssl rand -base64 32
AUTH_CODE_HASH_KEY=

# SMS and e-mail provider. Empty in Development: codes are kept in memory and listed at
# http://localhost:5080/dev/messages (Development only). No real provider exists yet.
MESSAGING_PROVIDER=

# For `dotnet run` outside Docker, set the connection string the same way, for example:
#   ConnectionStrings__Lalana="Host=localhost;Database=lalana;Username=lalana;Password=change-me-local"
